# Browser-visible API origin used by the Next.js application.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
API_HOST_PORT=8000
FRONTEND_HOST_PORT=3000

# Comma-separated browser origins allowed by the backend.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://meetingmind.local:3000

# Remote Colab inference service. Copy the values printed by MeetingMind_Colab_Inference.ipynb.
LLM_BACKEND=remote
LLM_BASE_URL=
LLM_API_KEY=
LLM_REQUEST_TIMEOUT=300
LLM_HEALTH_TIMEOUT=5

# Local CPU embeddings and retrieval settings.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MAX_CHUNKS=20
CHUNK_WORDS=600
CHUNK_OVERLAP=90
RAG_TOP_K=4
MIN_RETRIEVAL_SCORE=0.20
MAX_UPLOAD_BYTES=26214400
