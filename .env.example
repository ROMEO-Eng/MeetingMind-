# Browser-visible API origin used by the Next.js application.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Comma-separated browser origins allowed by the backend.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://meetingmind.local:3000

# Local model settings. Model downloads use the Hugging Face cache.
MODEL_NAME=mistralai/Mistral-Nemo-Instruct-2407
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MODEL_MAX_NEW_TOKENS=900
MAX_INPUT_TOKENS=8192
MAX_CHUNKS=20
CHUNK_WORDS=600
CHUNK_OVERLAP=90
RAG_TOP_K=4
MIN_RETRIEVAL_SCORE=0.20
MAX_UPLOAD_BYTES=26214400

# Required only for the optional notebook Docker profile.
JUPYTER_TOKEN=
